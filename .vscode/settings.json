{
  // 学习项目：关闭 AI 行内补全，保留普通补全（clangd）
  "editor.inlineSuggest.enabled": false,
  "github.copilot.enable": { "*": false },
  // 用 clangd 做补全和报错，关掉 cpptools 的 IntelliSense，避免重复提示（调试功能不受影响）
  "C_Cpp.intelliSenseEngine": "disabled",

  "cmake.useCMakePresets": "always",
  "editor.formatOnSave": true,
  "clangd.arguments": [
    "--background-index",
    "--clang-tidy",
    "--header-insertion=never",
    "--compile-commands-dir=${workspaceFolder}/build/gcc-debug"
  ]
}
